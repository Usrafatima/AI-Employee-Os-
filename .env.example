# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

# Backend Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="AI Employee OS"
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change_this_to_a_secure_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_employee_os
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_employee_os

# AI Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# Email Integration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME="AI Employee OS"

# Optional External Integrations
STORAGE_BUCKET=ai-employee-os-storage
WHATSAPP_API_TOKEN=your_whatsapp_api_token
CALENDAR_API_KEY=your_calendar_api_key
